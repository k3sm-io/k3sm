cmd/k3sm/enrollself_test.go until=2026-12-31 # httptest stub apiserver for MeshPeer self-enrollment
cmd/k3sm/image_test.go until=2026-12-31 # unix-socket stub of the runtimed Images service
cmd/k3sm/imagepush_test.go until=2026-12-31 # httptest registry plus a dead-port address for push failures
cmd/k3sm/joinlistener_test.go until=2026-12-31 # join listener bind and retry over real loopback sockets
cmd/k3sm/meshenrollregression_test.go until=2026-12-31 # httptest stub apiserver for MeshPeer create and rejoin
cmd/k3sm/node_test.go until=2026-12-31 # httptest server for request-cancellation on shutdown
cmd/k3sm/snapshot_test.go until=2026-12-31 # live control-plane probe needs a held loopback port

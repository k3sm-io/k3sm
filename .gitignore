# Build output
/dist/
# The release staging tree (hack/release/stage.sh). Deliberately OUTSIDE dist/:
# goreleaser owns that directory and empties it with --clean, which would delete
# the staged artifacts before the archive globs could read them.
/build/
/bin/
/k3sm
*.test
*.out

# Go workspace (local, spans sibling repos — lives in the parent dir)
go.work
go.work.sum

# Parallel-agent lane worktrees (.claude/rules/parallel-worktrees.md). Lanes normally live
# OUTSIDE this tree ($K3SM_LANE_ROOT, default ../k3sm-io.worktrees) so `go env GOWORK`
# cannot escape upward into the workspace go.work; this entry is defence in depth for a
# lane rooted in-tree by mistake. `hack/worktree.sh doctor` still reports one.
/.worktrees/

# macOS / editors
.DS_Store
.idea/
.vscode/

# hack/acceptance/m2.sh stages the gate's control-plane payload, binary, exec-shim
# and DYLD shims into the repo root; they are build outputs, never committed.
/cp-payload/
/k3sm-m2
/k3sm-execshim
/libk3sm_getaddrinfo_shim.dylib
/libk3sm_pathrebase_shim.dylib

# Disposable-guest evidence bundles (hack/lab-vm.sh collect). These carry the
# guest run's /Library/k3sm and /var/lib/k3sm state, which includes its bootstrap
# CA, node-password and join token. Per-run and disposable, but never committed.
lab-vm-out/

# hack/sit/criteria.env — the k3sm System Integration Test criterion manifest.
#
# ONE line per cross-component conformance criterion, three orthogonal fields:
#
#   tier=rootless|root|multinode|unbuilt
#       rootless  — provable at T0 (`k3sm dev up`, runtimed + network=none, NO root)
#       root      — needs T1 (`sudo k3sm dev up --datapath`, runtimed + network=direct)
#       multinode — needs a second joined Mac (single-node cannot prove it) → deferred
#       unbuilt   — a permanent t.Skip TODO stub (feature not yet built) → deferred,
#                   and EXCLUDED from every required-set (a required permanent-skip
#                   would red T1 forever)
#
#   root_reason=lo0-alias|lt1024-bind|setuid-uid-drop|—
#       WHY a root criterion needs root — the two ORTHOGONAL root axes:
#         datapath : a lo0 /32 alias (lo0-alias) or a <1024 VIP bind (lt1024-bind).
#                    NOTE even a >=1024 ClusterIP needs root for its lo0 ALIAS; only
#                    127.0.0.1 binds alias-free on Darwin. NodePort's >=1024 wildcard
#                    bind is rootless, so M3_NodePort's reason is its BACKEND pod's
#                    lo0-alias, NOT lt1024-bind.
#         uid-drop : setuid to a foreign runAsUser/fsGroup (setuid-uid-drop) — root-only
#                    even with the netd helper installed. Seatbelt self-confinement
#                    needs NEITHER, so DenyUsers is rootless.
#
#   fidelity=SAFE|datapath|unfaithful   (docs/UPSTREAM-ALIGNMENT.md verdict lens)
#       SAFE       — faithful rootless: reproduces on real k8s, develop freely
#       datapath   — faithful but needs the routing datapath (root here)
#       unfaithful — a documented k3sm ceiling; will NOT reproduce on real k8s
#
# CAPABILITY-PRINCIPLE IS AUTHORITATIVE. The empirical run only CROSS-CHECKS: a
# rootless-classified criterion that fails T0, or a root one that passes, is a
# MANIFEST BUG to investigate — never a silent auto-reclassify (that circularity
# would launder a vacuous pass). M1's Service/DNS objects pass T0 VACUOUSLY (the
# API objects exist; no datapath) — recorded object-only, not a datapath proof.

# ── M2: isolation, resources & pod-spec fidelity ────────────────────────────
# Volume/env/probe/graceful-stop are materialized by runtimed under network=none
# (no datapath, no uid-drop) → rootless + SAFE.
M2_ConfigMapMount            tier=rootless root_reason=—               fidelity=SAFE
M2_SecretMount               tier=rootless root_reason=—               fidelity=SAFE
M2_EmptyDir                  tier=rootless root_reason=—               fidelity=SAFE
M2_DownwardAPIEnv            tier=rootless root_reason=—               fidelity=SAFE
M2_EnvFrom                   tier=rootless root_reason=—               fidelity=SAFE
M2_Probes                    tier=rootless root_reason=—               fidelity=SAFE
M2_GracefulStop              tier=rootless root_reason=—               fidelity=SAFE
# Memory enforcement is the userspace rusage sampler → OOMKill: no root, no datapath.
M2_ResourceLimitsOOMKilled   tier=rootless root_reason=—               fidelity=SAFE
# kubelet Summary API over the apiserver->node loopback proxy: no root. But the
# metrics.k8s.io API is NOT served, so `kubectl top` proper diverges → unfaithful.
M2_KubectlTop                tier=rootless root_reason=—               fidelity=unfaithful
# Seatbelt self-confinement (sandbox_apply on the shim's own process) needs no root.
M2_DenyUsers                 tier=rootless root_reason=—               fidelity=SAFE
# fsGroup ownership needs a setuid uid-drop → root-only even with the helper.
M2_FsGroup                   tier=root     root_reason=setuid-uid-drop fidelity=datapath
# In-pod apiserver reach + cluster DNS both need the ClusterIP/DNS-VIP lo0 datapath.
M2_InPodKubectl              tier=root     root_reason=lo0-alias       fidelity=datapath
M2_InPodDNS                  tier=root     root_reason=lo0-alias       fidelity=datapath

# ── M3: single-node datapath ────────────────────────────────────────────────
# NodePort's *:port wildcard bind is rootless (>=1024), but its BACKEND pod needs a
# routable lo0 /32 → the reason is lo0-alias (backend), NOT lt1024-bind.
M3_NodePort                  tier=root     root_reason=lo0-alias       fidelity=datapath
# StatefulSet PVC data survives a pod restart — an APFS local-path PV. The pod's
# writable volume is materialized by runtimed; assert requires a running pod on the
# datapath tier here (validated under direct alongside NodePort).
M3_PVCPersistsAcrossRestart  tier=root     root_reason=lo0-alias       fidelity=datapath
# Cross-node in-pod kubectl + cluster DNS from a pod on a JOINED worker.
M3_InPodKubectlAndDNSOnWorker tier=multinode root_reason=—             fidelity=datapath

# ── M4: authz ───────────────────────────────────────────────────────────────
# Node,RBAC default-deny enforcement is an apiserver-config property → rootless SAFE.
M4_RBACEnforced              tier=rootless root_reason=—               fidelity=SAFE

# ── M10.0: apiserver conformance config ─────────────────────────────────────
# Audit level + PSA warn/enforce are apiserver-config properties the config-superset
# boot (--psa-enforce-baseline + K3SM_WORK_DIR) enables → rootless SAFE.
M10_AuditLogLevel            tier=rootless root_reason=—               fidelity=SAFE
M10_PSADefaultWarn           tier=rootless root_reason=—               fidelity=SAFE
M10_PSAEnforceCutover        tier=rootless root_reason=—               fidelity=SAFE

# ── M6: HA multi-writer (a second control-plane server) ──────────────────────
M6_LeaderElectionSingleActive        tier=multinode root_reason=—     fidelity=SAFE
M6_SecondServerJoinsReconstructsCAs  tier=multinode root_reason=—     fidelity=SAFE
M6_WatchStalenessSoak                tier=multinode root_reason=—     fidelity=SAFE
M6_WriteOnAReadOnB                    tier=multinode root_reason=—     fidelity=SAFE

# ── feature-unbuilt-deferred: permanent t.Skip TODO stubs ────────────────────
# EXCLUDED from every required-set (a required permanent-skip would red T1 forever).
M10_PerPodIP                 tier=unbuilt  root_reason=lo0-alias       fidelity=datapath
M10_Ingress                  tier=unbuilt  root_reason=lo0-alias       fidelity=datapath
M10_NativeSidecar            tier=unbuilt  root_reason=—               fidelity=unfaithful
M10_CrashLoopBackOff         tier=unbuilt  root_reason=—               fidelity=SAFE
M10_JobCompletion            tier=unbuilt  root_reason=—               fidelity=SAFE
M10_ProviderEvents           tier=unbuilt  root_reason=—               fidelity=unfaithful
M10_ImagePullSecret          tier=unbuilt  root_reason=—               fidelity=SAFE
